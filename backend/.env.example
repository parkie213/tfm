# For running the Java server directly after starting Postgres through Compose.
DB_URL=jdbc:postgresql://localhost:5433/tfm
DB_USER=tfm
DB_PASSWORD=tfm
GRPC_PORT=9090
GTFS_CACHE_DIR=/tmp/tfm-gtfs
OSRM_URL=
DARWIN_TOKEN=
BODS_API_KEY=
# Optional arrivals REST product:
DARWIN_ARRIVALS_BASE_URL=
DARWIN_ARRIVALS_TOKEN=
# The container setup's optional Kafka settings are documented in deploy/.env.example.
