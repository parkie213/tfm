# Copy to deploy/.env. Scheduled bus timetables need no API key.
# Optional RDM LDBWS REST consumer key for live train boards.
DARWIN_TOKEN=
# DARWIN_BASE_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120
# Arrivals require an arrivals product; its key falls back to DARWIN_TOKEN.
DARWIN_ARRIVALS_BASE_URL=
DARWIN_ARRIVALS_TOKEN=

# Optional live buses from BODS SIRI-VM.
BODS_API_KEY=
# BODS_BBOX=-1.25,52.55,-0.65,52.90

# Bulk timetable loading can use substantial memory on the first run.
# JAVA_TOOL_OPTIONS=-Xmx3g
# GTFS_REGIONS=east_midlands
# GTFS_LOAD_SHAPES=true
# NAPTAN_AREAS=

# Optional local OSRM server for road-snapped bus geometry.
# With no server configured, GTFS route shapes are used.
# OSRM_URL=http://host.docker.internal:5000
# OSRM_COVERAGE_BBOX=52.42,-1.58,53.60,0.25
# OSRM_VERSION=

# Optional Darwin Kafka feed for platform occupancy and near-term train schedules.
DARWIN_KAFKA_BOOTSTRAP=
DARWIN_KAFKA_TOPIC=
DARWIN_KAFKA_KEY=
DARWIN_KAFKA_SECRET=
# Use the group issued by your subscription, if one is required.
# DARWIN_KAFKA_GROUP=tfm-local
